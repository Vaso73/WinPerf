<Window x:Class="WinPerf.App.CustomCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Custom iperf3 command"
        Icon="Assets/WinPerf.ico"
        Width="760"
        Height="500"
        MinWidth="640"
        MinHeight="440"
        Background="#08111F"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="12" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>

        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}" />

        <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxBase}">
            <Setter Property="Padding" Value="12" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxBase}">
            <Setter Property="Padding" Value="10,0,10,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonBase}">
            <Setter Property="Padding" Value="18,10" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonBase}">
            <Setter Property="Padding" Value="18,10" />
        </Style>
    </Window.Resources>

    <Border Background="#08111F"
            BorderBrush="#38BDF8"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True">
        <Grid Background="#08111F">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#07101D"
                    BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0">
                        <Image Source="Assets/WinPerf.ico"
                               Width="16"
                               Height="16"
                               Margin="0,0,6,0" />
                        <TextBlock Text="Custom iperf3 command"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton"
                                Content="—"
                                Width="40"
                                Height="38"
                                Background="Transparent"
                                Foreground="{StaticResource TextMain}"
                                BorderThickness="0"
                                FontSize="11"
                                Click="MinimizeButton_Click" />
                        <Button x:Name="MaximizeRestoreButton"
                                Content="□"
                                Width="40"
                                Height="38"
                                Background="Transparent"
                                Foreground="{StaticResource TextMain}"
                                BorderThickness="0"
                                FontSize="11"
                                Click="MaximizeRestoreButton_Click" />
                        <Button x:Name="CloseButton"
                                Content="×"
                                Width="40"
                                Height="38"
                                Background="Transparent"
                                Foreground="{StaticResource TextMain}"
                                BorderThickness="0"
                                FontSize="11"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Custom iperf3 command"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Use this for advanced flags, public servers, server mode, UDP bitrate tuning, or manual troubleshooting."
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="130" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource Panel}"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Command"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />

                            <ComboBox x:Name="CommandBox"
                                      Grid.Row="1"
                                      Height="38"
                                      MinHeight="32"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      VerticalContentAlignment="Center"
                                      Text="-c 10.100.100.1 -p 5201 -t 10 -P 10 --json-stream -4" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{StaticResource PanelSoft}"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="Examples"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <TextBlock Foreground="{StaticResource TextMuted}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="11"
                                       TextWrapping="Wrap"><Run Text="TCP upload:     -c 10.100.100.1 -P 10 -t 10 -4 --json-stream" /><LineBreak /><Run Text="TCP download:   -c 10.100.100.1 -R -P 10 -t 10 -4 --json-stream" /><LineBreak /><Run Text="UDP upload:     -c 10.100.100.1 -u -b 0 -t 10 -4 --json-stream" /><LineBreak /><Run Text="Server mode:    -s -p 5201" /></TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
                    <TextBlock Text="For live charts, prefer --json-stream."
                               DockPanel.Dock="Left"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" />

                    <Button Content="Cancel"
                            DockPanel.Dock="Right"
                            Style="{StaticResource SecondaryButton}"
                            Width="100"
                            Margin="6,0,0,0"
                            Click="CancelButton_Click" />

                    <Button Content="Use Command"
                            DockPanel.Dock="Right"
                            Style="{StaticResource PrimaryButton}"
                            Width="124"
                            Click="UseButton_Click" />
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
