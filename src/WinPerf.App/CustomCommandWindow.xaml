<Window x:Class="WinPerf.App.CustomCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Custom iperf3 command"
        Icon="Assets/WinPerf.ico"
        Width="820"
        Height="560"
        MinWidth="700"
        MinHeight="500"
        Background="#08111F"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="14" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#0F1B2E" />
        <SolidColorBrush x:Key="PanelSoft" Color="#13233A" />
        <SolidColorBrush x:Key="BorderSoft" Color="#203554" />
        <SolidColorBrush x:Key="TextMain" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />
        <SolidColorBrush x:Key="Accent" Color="#38BDF8" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1628" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#03111F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#172A44" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Border Background="#08111F"
            BorderBrush="#38BDF8"
            BorderThickness="1"
            CornerRadius="14"
            SnapsToDevicePixels="True">
        <Grid Background="#08111F">
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#07101D"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,0,0,1"
                CornerRadius="13,13,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Image Source="Assets/WinPerf.ico"
                           Width="18"
                           Height="18"
                           Margin="0,0,8,0" />
                    <TextBlock Text="Custom iperf3 command"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton"
                            Content="—"
                            Width="46"
                            Height="42"
                            Background="Transparent"
                            Foreground="{StaticResource TextMain}"
                            BorderThickness="0"
                            FontSize="14"
                            Click="MinimizeButton_Click" />
                    <Button x:Name="MaximizeRestoreButton"
                            Content="□"
                            Width="46"
                            Height="42"
                            Background="Transparent"
                            Foreground="{StaticResource TextMain}"
                            BorderThickness="0"
                            FontSize="13"
                            Click="MaximizeRestoreButton_Click" />
                    <Button x:Name="CloseButton"
                            Content="×"
                            Width="46"
                            Height="42"
                            Background="Transparent"
                            Foreground="{StaticResource TextMain}"
                            BorderThickness="0"
                            FontSize="18"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

            <Grid Grid.Row="1" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Custom iperf3 command"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Text="Use this for advanced flags, public servers, server mode, UDP bitrate tuning, or manual troubleshooting."
                       Foreground="{StaticResource TextMuted}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="160" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="18"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Command"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12" />

                    <TextBox x:Name="CommandBox"
                             Grid.Row="1"
                             MinHeight="48"
                             AcceptsReturn="False"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Disabled"
                             VerticalContentAlignment="Center"
                             Text="iperf3.exe -c 10.100.100.1 -p 5201 -t 10 -P 10 --json-stream -4" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource PanelSoft}"
                    BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Examples"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBlock Foreground="{StaticResource TextMuted}"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="12"
                               TextWrapping="Wrap"><Run Text="TCP upload:     iperf3.exe -c 10.100.100.1 -P 10 -t 10 -4 --json-stream" /><LineBreak /><Run Text="TCP download:   iperf3.exe -c 10.100.100.1 -R -P 10 -t 10 -4 --json-stream" /><LineBreak /><Run Text="UDP upload:     iperf3.exe -c 10.100.100.1 -u -b 0 -t 10 -4 --json-stream" /><LineBreak /><Run Text="Server mode:    iperf3.exe -s -p 5201" /></TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,18,0,0" LastChildFill="False">
            <TextBlock Text="For live charts, prefer --json-stream."
                       DockPanel.Dock="Left"
                       Foreground="{StaticResource TextMuted}"
                       VerticalAlignment="Center" />

            <Button Content="Cancel"
                    DockPanel.Dock="Right"
                    Style="{StaticResource SecondaryButton}"
                    Width="110"
                    Margin="10,0,0,0"
                    Click="CancelButton_Click" />

            <Button Content="Use Command"
                    DockPanel.Dock="Right"
                    Style="{StaticResource PrimaryButton}"
                    Width="140"
                    Click="UseButton_Click" />
        </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
