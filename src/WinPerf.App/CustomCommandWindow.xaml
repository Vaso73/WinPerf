<Window x:Class="WinPerf.App.CustomCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom iperf3 command"
        Width="820"
        Height="560"
        MinWidth="700"
        MinHeight="500"
        Background="#08111F"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#0F1B2E" />
        <SolidColorBrush x:Key="PanelSoft" Color="#13233A" />
        <SolidColorBrush x:Key="BorderSoft" Color="#203554" />
        <SolidColorBrush x:Key="TextMain" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />
        <SolidColorBrush x:Key="Accent" Color="#38BDF8" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1628" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#03111F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#172A44" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Custom iperf3 command"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Text="Use this for advanced flags, public servers, server mode, UDP bitrate tuning, or manual troubleshooting."
                       Foreground="{StaticResource TextMuted}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="160" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="18"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Command"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12" />

                    <TextBox x:Name="CommandBox"
                             Grid.Row="1"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="iperf3.exe -c 10.100.100.1 -p 5201 -t 10 -P 10 --json-stream -4" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource PanelSoft}"
                    BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Examples"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBlock Foreground="{StaticResource TextMuted}"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="12"
                               TextWrapping="Wrap"><Run Text="TCP upload:     iperf3.exe -c 10.100.100.1 -P 10 -t 10 -4 --json-stream" /><LineBreak /><Run Text="TCP download:   iperf3.exe -c 10.100.100.1 -R -P 10 -t 10 -4 --json-stream" /><LineBreak /><Run Text="UDP upload:     iperf3.exe -c 10.100.100.1 -u -b 0 -t 10 -4 --json-stream" /><LineBreak /><Run Text="Server mode:    iperf3.exe -s -p 5201" /></TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,18,0,0" LastChildFill="False">
            <TextBlock Text="For live charts, prefer --json-stream."
                       DockPanel.Dock="Left"
                       Foreground="{StaticResource TextMuted}"
                       VerticalAlignment="Center" />

            <Button Content="Cancel"
                    DockPanel.Dock="Right"
                    Style="{StaticResource SecondaryButton}"
                    Width="110"
                    Margin="10,0,0,0"
                    Click="CancelButton_Click" />

            <Button Content="Use Command"
                    DockPanel.Dock="Right"
                    Style="{StaticResource PrimaryButton}"
                    Width="140"
                    Click="UseButton_Click" />
        </DockPanel>
    </Grid>
</Window>
