<Window x:Class="WinPerf.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinPerf Settings"
        Width="760"
        Height="430"
        MinWidth="680"
        MinHeight="380"
        Background="#08111F"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#0F1B2E" />
        <SolidColorBrush x:Key="PanelSoft" Color="#13233A" />
        <SolidColorBrush x:Key="BorderSoft" Color="#203554" />
        <SolidColorBrush x:Key="TextMain" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />
        <SolidColorBrush x:Key="Accent" Color="#38BDF8" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1628" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#03111F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#172A44" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Settings"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Text="Configure the iperf3 engine used by WinPerf. Auto-download/update will be added later."
                       Foreground="{StaticResource TextMuted}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource Panel}"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18">
            <StackPanel>
                <TextBlock Text="iperf3 executable"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />

                <TextBlock Text="Path to iperf3.exe"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12" />

                <Grid Margin="0,5,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="105" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="IperfPathBox"
                             Grid.Column="0"
                             VerticalContentAlignment="Center" />

                    <Button Grid.Column="2"
                            Content="Browse"
                            Style="{StaticResource SecondaryButton}"
                            Click="BrowseButton_Click" />

                    <Button Grid.Column="4"
                            Content="Clear"
                            Style="{StaticResource SecondaryButton}"
                            Click="ClearButton_Click" />
                </Grid>

                <Border Background="{StaticResource PanelSoft}"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="Fallback path"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="If no manual path is configured, WinPerf will later try tools\iperf3\iperf3.exe next to WinPerf.exe."
                                   Foreground="{StaticResource TextMuted}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,18,0,0" LastChildFill="False">
            <TextBlock x:Name="ValidationText"
                       DockPanel.Dock="Left"
                       Foreground="{StaticResource TextMuted}"
                       VerticalAlignment="Center" />

            <Button Content="Cancel"
                    DockPanel.Dock="Right"
                    Style="{StaticResource SecondaryButton}"
                    Width="110"
                    Margin="10,0,0,0"
                    Click="CancelButton_Click" />

            <Button Content="Save"
                    DockPanel.Dock="Right"
                    Style="{StaticResource PrimaryButton}"
                    Width="110"
                    Click="SaveButton_Click" />
        </DockPanel>
    </Grid>
</Window>
