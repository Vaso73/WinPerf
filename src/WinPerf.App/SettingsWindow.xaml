<Window x:Class="WinPerf.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WinPerf Settings"
        Icon="Assets/WinPerf.ico"
        Width="720"
        Height="460"
        MinWidth="660"
        MinHeight="420"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="12" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>

        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}" />

        <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxBase}">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonBase}">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonBase}">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Bg}"
            BorderBrush="{StaticResource Accent}"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True">
        <Grid Background="{StaticResource Bg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PanelDark}"
                    BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0">
                        <Image Source="Assets/WinPerf.ico"
                               Width="16"
                               Height="16"
                               Margin="0,0,6,0" />
                        <TextBlock Text="WinPerf Settings"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton"
                                Content="—"
                                Width="40"
                                Height="38"
                                Background="Transparent"
                                Foreground="{StaticResource TextMain}"
                                BorderThickness="0"
                                FontSize="11"
                                Click="MinimizeButton_Click" />
                        <Button x:Name="MaximizeRestoreButton"
                                Content="□"
                                Width="40"
                                Height="38"
                                Background="Transparent"
                                Foreground="{StaticResource TextMain}"
                                BorderThickness="0"
                                FontSize="11"
                                Click="MaximizeRestoreButton_Click" />
                        <Button x:Name="CloseButton"
                                Content="×"
                                Width="40"
                                Height="38"
                                Background="Transparent"
                                Foreground="{StaticResource TextMain}"
                                BorderThickness="0"
                                FontSize="11"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="Settings"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Configure portable iperf engines used by WinPerf."
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border Background="{StaticResource Panel}"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="iperf3 executable"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />

                            <TextBlock Text="Path to iperf3.exe"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="11" />

                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="108" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="68" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="IperfPathBox"
                                         Grid.Column="0"
                                         VerticalContentAlignment="Center" />

                                <Button Grid.Column="2"
                                        Content="Browse"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="BrowseButton_Click" />

                                <Button Grid.Column="4"
                                        Content="Import"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="ImportPortableButton_Click" />

                                <Button Grid.Column="6"
                                        Content="Clear"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="ClearButton_Click" />
                            </Grid>

                            <Border Background="{StaticResource PanelSoft}"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="8">
                                <StackPanel>
                                    <TextBlock Text="iperf3 fallback"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="Fallback: tools\iperf3\iperf3.exe next to WinPerf.exe. Import copies a selected portable folder there."
                                               Foreground="{StaticResource TextMuted}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="iperf2 executable"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,6" />

                            <TextBlock Text="Path to iperf.exe or iperf2.exe"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="11" />

                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="108" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="68" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="Iperf2PathBox"
                                         Grid.Column="0"
                                         VerticalContentAlignment="Center" />

                                <Button Grid.Column="2"
                                        Content="Browse"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="BrowseIperf2Button_Click" />

                                <Button Grid.Column="4"
                                        Content="Import"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="ImportPortableIperf2Button_Click" />

                                <Button Grid.Column="6"
                                        Content="Clear"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="ClearIperf2Button_Click" />
                            </Grid>

                            <Border Background="{StaticResource PanelSoft}"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="8">
                                <StackPanel>
                                    <TextBlock Text="iperf2 fallback"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="Fallback: tools\iperf2\iperf.exe or iperf2.exe next to WinPerf.exe. Current iperf2 support covers TCP Upload and UDP Upload."
                                               Foreground="{StaticResource TextMuted}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource PanelSoft}"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="8"
                                    Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Portable data folder"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,4" />
                                        <TextBlock x:Name="DataDirectoryText"
                                                   Foreground="{StaticResource TextMuted}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Button x:Name="OpenDataDirectoryButton"
                                            Grid.Column="2"
                                            Content="Open data"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="OpenDataDirectoryButton_Click" />
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource PanelSoft}"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="8"
                                    Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Portable iperf3 engine folder"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,4" />
                                        <TextBlock x:Name="PortableIperf3EngineDirectoryText"
                                                   Foreground="{StaticResource TextMuted}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Button x:Name="OpenPortableEngineDirectoryButton"
                                            Grid.Column="2"
                                            Content="Open iperf3"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="OpenPortableEngineDirectoryButton_Click" />
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource PanelSoft}"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="8"
                                    Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Portable iperf2 engine folder"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,4" />
                                        <TextBlock x:Name="PortableIperf2EngineDirectoryText"
                                                   Foreground="{StaticResource TextMuted}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Button x:Name="OpenPortableIperf2EngineDirectoryButton"
                                            Grid.Column="2"
                                            Content="Open iperf2"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="OpenPortableIperf2EngineDirectoryButton_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="184" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ValidationText"
                               Grid.Column="0"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Save"
                                Style="{StaticResource PrimaryButton}"
                                Width="88"
                                Margin="0,0,6,0"
                                Click="SaveButton_Click" />

                        <Button Content="Cancel"
                                Style="{StaticResource SecondaryButton}"
                                Width="88"
                                Click="CancelButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
