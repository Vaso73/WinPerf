<Window x:Class="WinPerf.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:WinPerf.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WinPerf Settings"
        Icon="Assets/WinPerf.ico"
        Width="720"
        Height="460"
        MinWidth="660"
        MinHeight="420"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <app:AppWindowChrome />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource ShellWindowBorder}">
        <Grid Background="{StaticResource Bg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ShellTitleBar}">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0">
                        <Image Source="Assets/WinPerf.ico"
                               Width="16"
                               Height="16"
                               Margin="0,0,6,0" />
                        <TextBlock Text="WinPerf Settings"
                                   Style="{StaticResource ShellTitleText}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton"
                                Content="—"
                                Style="{StaticResource ShellTitleButton}"
                                Click="MinimizeButton_Click" />
                        <Button x:Name="MaximizeRestoreButton"
                                Content="□"
                                Style="{StaticResource ShellTitleButton}"
                                Click="MaximizeRestoreButton_Click" />
                        <Button x:Name="CloseButton"
                                Content="×"
                                Style="{StaticResource ShellCloseTitleButton}"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="Settings"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Configure portable iperf engines used by WinPerf."
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border Background="{StaticResource Panel}"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10"
                            ClipToBounds="True">
                        <StackPanel>
                            <Border Background="{StaticResource PanelSoft}"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="8"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="4" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="Language"
                                               FontSize="11"
                                               FontWeight="SemiBold" />

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Text="WinPerfLanguage.Description"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,0,12,0" />

                                    <ComboBox x:Name="LanguageBox"
                                              Grid.Row="0"
                                              Grid.RowSpan="3"
                                              Grid.Column="1"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <TextBlock Text="Engines"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="7"
                                           Text="iperf3 executable · fallback tools\iperf3\iperf3.exe"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBox x:Name="IperfPathBox"
                                         Grid.Row="2"
                                         Grid.Column="0"
                                         VerticalContentAlignment="Center" />

                                <Button Grid.Row="2"
                                        Grid.Column="2"
                                        Content="Browse"
                                        Style="{StaticResource CompactSecondaryButton}"
                                        Click="BrowseButton_Click" />

                                <Button Grid.Row="2"
                                        Grid.Column="4"
                                        Content="Import"
                                        Style="{StaticResource CompactSecondaryButton}"
                                        Click="ImportPortableButton_Click" />

                                <Button Grid.Row="2"
                                        Grid.Column="6"
                                        Content="Clear"
                                        Style="{StaticResource CompactSecondaryButton}"
                                        Click="ClearButton_Click" />

                                <TextBlock x:Name="Iperf2SettingsLabel"
                                           Grid.Row="4"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="7"
                                           Text="iperf2 executable · fallback tools\iperf2\iperf.exe or iperf2.exe"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBox x:Name="Iperf2PathBox"
                                         Grid.Row="6"
                                         Grid.Column="0"
                                         VerticalContentAlignment="Center" />

                                <Button x:Name="BrowseIperf2Button"
                                        Grid.Row="6"
                                        Grid.Column="2"
                                        Content="Browse"
                                        Style="{StaticResource CompactSecondaryButton}"
                                        Click="BrowseIperf2Button_Click" />

                                <Button x:Name="ImportPortableIperf2Button"
                                        Grid.Row="6"
                                        Grid.Column="4"
                                        Content="Import"
                                        Style="{StaticResource CompactSecondaryButton}"
                                        Click="ImportPortableIperf2Button_Click" />

                                <Button x:Name="ClearIperf2Button"
                                        Grid.Row="6"
                                        Grid.Column="6"
                                        Content="Clear"
                                        Style="{StaticResource CompactSecondaryButton}"
                                        Click="ClearIperf2Button_Click" />
                            </Grid>

                            <Border Background="{StaticResource PanelSoft}"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="8"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Portable folders"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6" />

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="6" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="6" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="142" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="104" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="Portable data folder"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="DataDirectoryText"
                                                   Grid.Row="0"
                                                   Grid.Column="1"
                                                   Foreground="{StaticResource TextMuted}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="OpenDataDirectoryButton"
                                                Grid.Row="0"
                                                Grid.Column="3"
                                                Content="Open data"
                                                Style="{StaticResource CompactSecondaryButton}"
                                                Click="OpenDataDirectoryButton_Click" />

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Text="Portable iperf3 engine folder"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="PortableIperf3EngineDirectoryText"
                                                   Grid.Row="2"
                                                   Grid.Column="1"
                                                   Foreground="{StaticResource TextMuted}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="OpenPortableEngineDirectoryButton"
                                                Grid.Row="2"
                                                Grid.Column="3"
                                                Content="Open iperf3"
                                                Style="{StaticResource CompactSecondaryButton}"
                                                Click="OpenPortableEngineDirectoryButton_Click" />

                                        <TextBlock x:Name="PortableIperf2EngineDirectoryLabel"
                                                   Grid.Row="4"
                                                   Grid.Column="0"
                                                   Text="Portable iperf2 engine folder"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="PortableIperf2EngineDirectoryText"
                                                   Grid.Row="4"
                                                   Grid.Column="1"
                                                   Foreground="{StaticResource TextMuted}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="OpenPortableIperf2EngineDirectoryButton"
                                                Grid.Row="4"
                                                Grid.Column="3"
                                                Content="Open iperf2"
                                                Style="{StaticResource CompactSecondaryButton}"
                                                Click="OpenPortableIperf2EngineDirectoryButton_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="278" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ValidationText"
                               Grid.Column="0"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Apply"
                                Style="{StaticResource CompactSecondaryButton}"
                                Width="88"
                                Margin="0,0,6,0"
                                Click="ApplyButton_Click" />

                        <Button Content="Save"
                                Style="{StaticResource CompactPrimaryButton}"
                                Width="88"
                                Margin="0,0,6,0"
                                Click="SaveButton_Click" />

                        <Button Content="Cancel"
                                Style="{StaticResource CompactSecondaryButton}"
                                Width="88"
                                Click="CancelButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
