<Window x:Class="WinPerf.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="About WinPerf"
        Icon="Assets/WinPerf.ico"
        Width="700"
        Height="480"
        MinWidth="640"
        MinHeight="420"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="12" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>

        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}" />

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonBase}">
            <Setter Property="Padding" Value="18,10" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonBase}">
            <Setter Property="Padding" Value="18,10" />
        </Style>

        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource CardBase}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Bg}"
            BorderBrush="{StaticResource Accent}"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True">
        <Grid Background="{StaticResource Bg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PanelDark}"
                    BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0">
                        <Image Source="Assets/WinPerf.ico"
                               Width="16"
                               Height="16"
                               Margin="0,0,6,0" />
                        <TextBlock Text="About WinPerf"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton"
                                Content="—"
                                Width="40"
                                Height="38"
                                Background="Transparent"
                                Foreground="{StaticResource TextMain}"
                                BorderThickness="0"
                                FontSize="11"
                                Click="MinimizeButton_Click" />
                        <Button x:Name="MaximizeRestoreButton"
                                Content="□"
                                Width="40"
                                Height="38"
                                Background="Transparent"
                                Foreground="{StaticResource TextMain}"
                                BorderThickness="0"
                                FontSize="11"
                                Click="MaximizeRestoreButton_Click" />
                        <Button x:Name="CloseButton"
                                Content="×"
                                Width="40"
                                Height="38"
                                Background="Transparent"
                                Foreground="{StaticResource TextMain}"
                                BorderThickness="0"
                                FontSize="11"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="About WinPerf"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Network Performance Toolkit for iperf3 and iperf2 testing."
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               Margin="0,3,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Version"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,0,12,8" />
                                <TextBlock x:Name="VersionText"
                                           Grid.Row="0"
                                           Grid.Column="1"
                                           Text="WinPerf"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Edition"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,0,12,8" />
                                <TextBlock x:Name="EditionText"
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           Text="Sponsor Pro planned; free edition will be reduced"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="Package"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,0,12,0" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="Single portable WinPerf.exe"
                                           FontWeight="SemiBold" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Sponsor Pro / Updates"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Text="Update integration"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="11" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="Update core"
                                           Margin="0,0,12,7" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="Ready"
                                           Foreground="{StaticResource AccentGreen}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,12,7" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="2"
                                           Text="Client, manifest validation and installer contract are loaded"
                                           Foreground="{StaticResource TextMuted}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,7" />

                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Text="Product"
                                           Margin="0,0,12,7" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Text="winperf"
                                           Foreground="{StaticResource AccentGreen}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,12,7" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="2"
                                           Text="sponsor-pro / WinPerf.zip"
                                           Foreground="{StaticResource TextMuted}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,7" />

                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           Text="Account"
                                           Margin="0,0,12,7" />
                                <TextBlock Grid.Row="4"
                                           Grid.Column="1"
                                           Text="Not signed in"
                                           Foreground="{StaticResource AccentAmber}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,12,7" />
                                <TextBlock Grid.Row="4"
                                           Grid.Column="2"
                                           Text="GitHub Sponsor Pro login UI will be wired in the next step"
                                           Foreground="{StaticResource TextMuted}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,7" />

                                <StackPanel Grid.Row="5"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="3"
                                            Orientation="Horizontal"
                                            Margin="0,6,0,0">
                                    <Button x:Name="CheckUpdatesButton"
                                            Content="Check for updates"
                                            Style="{StaticResource SecondaryButton}"
                                            Width="170"
                                            IsEnabled="False"
                                            ToolTip="Sponsor Pro update UI will be connected in the next step." />
                                    <Button x:Name="SponsorLoginButton"
                                            Content="Sponsor Pro login"
                                            Style="{StaticResource SecondaryButton}"
                                            Width="170"
                                            Margin="8,0,0,0"
                                            IsEnabled="False"
                                            ToolTip="Sponsor Pro login UI will be connected in the next step." />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="2"
                        Content="Close"
                        Style="{StaticResource PrimaryButton}"
                        Width="110"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0"
                        Click="CloseButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
