<Window x:Class="WinPerf.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="About WinPerf"
        Icon="Assets/WinPerf.ico"
        Width="620"
        Height="500"
        MinWidth="600"
        MinHeight="480"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="12" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}" />

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonBase}">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinWidth" Value="118" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonBase}">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinWidth" Value="150" />
        </Style>

        <Style x:Key="AboutPanel" TargetType="Border" BasedOn="{StaticResource CardBase}">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Bg}"
            BorderBrush="{StaticResource Accent}"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True">
        <DockPanel Background="{StaticResource Bg}">
            <Border DockPanel.Dock="Top"
                    Height="38"
                    Background="{StaticResource PanelDark}"
                    BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0">
                        <Image Source="Assets/WinPerf.ico"
                               Width="16"
                               Height="16"
                               Margin="0,0,6,0" />
                        <TextBlock Text="About WinPerf"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button x:Name="TitleCloseButton"
                            Content="×"
                            Width="40"
                            Height="38"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            Foreground="{StaticResource TextMain}"
                            BorderThickness="0"
                            FontSize="11"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource PanelDark}"
                    BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="0,1,0,0"
                    Padding="18">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CheckForUpdatesButton"
                            Content="Check for updates"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"
                            Click="CheckForUpdatesButton_Click" />
                    <Button Content="Close"
                            Style="{StaticResource PrimaryButton}"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Border>

            <Grid Margin="28,24,28,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Image Source="Assets/WinPerf.ico"
                           Width="54"
                           Height="54"
                           Margin="0,0,16,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WinPerf"
                                   FontSize="26"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="EditionText"
                                   Text="Sponsor Pro planned · Free edition will be reduced"
                                   Foreground="{StaticResource Accent}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1"
                      Margin="0,22,0,0"
                      HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Version"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="12"
                               Margin="0,0,8,0" />
                    <TextBlock x:Name="VersionText"
                               Grid.Column="1"
                               Text="WinPerf"
                               FontSize="12"
                               FontWeight="SemiBold" />
                </Grid>

                <Border x:Name="AccountPanel"
                        Grid.Row="2"
                        Style="{StaticResource AboutPanel}"
                        Margin="0,22,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="42"
                                Height="42"
                                CornerRadius="21"
                                Background="{StaticResource Accent}"
                                Margin="0,0,12,0">
                            <TextBlock Text="GH"
                                       Foreground="{StaticResource Bg}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="AccountTitleText"
                                       Text="Not signed in"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="AccountStatusText"
                                       Text="Sign in with GitHub to use Sponsor Pro updates."
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <Button x:Name="SponsorProAccountButton"
                                Grid.Column="2"
                                Content="Sponsor Pro / Updates"
                                Style="{StaticResource SecondaryButton}"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                Click="SponsorProAccountButton_Click" />
                    </Grid>
                </Border>

                <ProgressBar x:Name="BusyProgress"
                             Grid.Row="3"
                             Height="4"
                             Margin="24,18,24,0"
                             IsIndeterminate="True"
                             Visibility="Collapsed" />

                <Border Grid.Row="4"
                        Style="{StaticResource AboutPanel}"
                        Margin="0,18,0,0">
                    <TextBlock x:Name="StatusText"
                               Text="Single portable WinPerf.exe. Updates use the private Sponsor Pro channel."
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="13" />
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
