<Window x:Class="WinPerf.App.AdvancedCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Advanced iperf3 builder"
        Icon="Assets/WinPerf.ico"
        Width="980"
        Height="760"
        MinWidth="900"
        MinHeight="680"
        Background="#08111F"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        WindowStyle="None"
        ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="14" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#0F1B2E" />
        <SolidColorBrush x:Key="PanelSoft" Color="#13233A" />
        <SolidColorBrush x:Key="BorderSoft" Color="#203554" />
        <SolidColorBrush x:Key="TextMain" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />
        <SolidColorBrush x:Key="Accent" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentGreen" Color="#22C55E" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1628" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0B1628" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#03111F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#172A44" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
        </Style>
    </Window.Resources>

    <Border Background="#08111F"
            BorderBrush="#38BDF8"
            BorderThickness="1"
            CornerRadius="14"
            SnapsToDevicePixels="True">
        <Grid Background="#08111F">
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#07101D"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,0,0,1"
                CornerRadius="13,13,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Image Source="Assets/WinPerf.ico"
                           Width="18"
                           Height="18"
                           Margin="0,0,8,0" />
                    <TextBlock Text="Advanced iperf3 builder"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton"
                            Content="—"
                            Width="46"
                            Height="42"
                            Background="Transparent"
                            Foreground="{StaticResource TextMain}"
                            BorderThickness="0"
                            FontSize="14"
                            Click="MinimizeButton_Click" />
                    <Button x:Name="MaximizeRestoreButton"
                            Content="□"
                            Width="46"
                            Height="42"
                            Background="Transparent"
                            Foreground="{StaticResource TextMain}"
                            BorderThickness="0"
                            FontSize="13"
                            Click="MaximizeRestoreButton_Click" />
                    <Button x:Name="CloseButton"
                            Content="×"
                            Width="46"
                            Height="42"
                            Background="Transparent"
                            Foreground="{StaticResource TextMain}"
                            BorderThickness="0"
                            FontSize="18"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

            <Grid Grid.Row="1" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Advanced iperf3 builder"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Text="Click parameters and WinPerf will generate the exact iperf3 command before running it."
                       Foreground="{StaticResource TextMuted}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0" />

            <Border Background="{StaticResource PanelSoft}"
                    BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="12"
                    Margin="0,14,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Saved profile"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="12" />
                        <ComboBox x:Name="ProfileBox"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="ProfileBox_SelectionChanged"
                                  Margin="0,5,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Profile name"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="12" />
                        <TextBox x:Name="ProfileNameBox"
                                 Text="LAN TCP 10s x10"
                                 Margin="0,5,0,0" />
                    </StackPanel>

                    <DockPanel Grid.Row="1"
                               Grid.ColumnSpan="3"
                               Margin="0,12,0,0"
                               LastChildFill="False">
                        <TextBlock x:Name="ProfileStatusText"
                                   DockPanel.Dock="Left"
                                   Text="Profiles are stored in %APPDATA%\WinPerf\profiles.json"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />

                        <Button Content="Delete"
                                DockPanel.Dock="Right"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="104"
                                MinHeight="38"
                                Padding="10,4"
                                Margin="8,0,0,0"
                                Click="DeleteProfileButton_Click" />

                        <Button Content="Set default"
                                DockPanel.Dock="Right"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="140"
                                MinHeight="38"
                                Padding="10,4"
                                Margin="8,0,0,0"
                                Click="SetDefaultProfileButton_Click" />

                        <Button Content="Save as new"
                                DockPanel.Dock="Right"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="150"
                                MinHeight="38"
                                Padding="10,4"
                                Margin="8,0,0,0"
                                Click="SaveProfileAsNewButton_Click" />

                        <Button Content="Save"
                                DockPanel.Dock="Right"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="104"
                                MinHeight="38"
                                Padding="10,4"
                                Margin="8,0,0,0"
                                Click="SaveProfileButton_Click" />
                    </DockPanel>
                </Grid>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Mode"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="Run mode" Foreground="{StaticResource TextMuted}" FontSize="12" />
                            <ComboBox x:Name="RunModeBox" SelectedIndex="0" SelectionChanged="AnyInputChanged" Margin="0,5,0,12">
                                <ComboBoxItem Content="Client mode" />
                                <ComboBoxItem Content="Server mode" />
                            </ComboBox>

                            <TextBlock Text="Protocol" Foreground="{StaticResource TextMuted}" FontSize="12" />
                            <ComboBox x:Name="ProtocolBox" SelectedIndex="0" SelectionChanged="AnyInputChanged" Margin="0,5,0,12">
                                <ComboBoxItem Content="TCP" />
                                <ComboBoxItem Content="UDP" />
                            </ComboBox>

                            <TextBlock Text="IP version" Foreground="{StaticResource TextMuted}" FontSize="12" />
                            <ComboBox x:Name="IpVersionBox" SelectedIndex="1" SelectionChanged="AnyInputChanged" Margin="0,5,0,0">
                                <ComboBoxItem Content="Default" />
                                <ComboBoxItem Content="IPv4" />
                                <ComboBoxItem Content="IPv6" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Endpoint"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="Server address / host" Foreground="{StaticResource TextMuted}" FontSize="12" />
                            <TextBox x:Name="ServerAddressBox" Text="10.100.100.1" TextChanged="AnyInputChanged" Margin="0,5,0,12" />

                            <TextBlock Text="Bind address, optional" Foreground="{StaticResource TextMuted}" FontSize="12" />
                            <TextBox x:Name="BindAddressBox" TextChanged="AnyInputChanged" Margin="0,5,0,12" />

                            <TextBlock Text="Port" Foreground="{StaticResource TextMuted}" FontSize="12" />
                            <TextBox x:Name="PortBox" Text="5201" TextChanged="AnyInputChanged" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Output"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="Report format" Foreground="{StaticResource TextMuted}" FontSize="12" />
                            <ComboBox x:Name="FormatBox" SelectedIndex="2" SelectionChanged="AnyInputChanged" Margin="0,5,0,12">
                                <ComboBoxItem Content="Kbits/sec" Tag="k" />
                                <ComboBoxItem Content="Mbits/sec" Tag="m" />
                                <ComboBoxItem Content="MBytes/sec" Tag="M" />
                                <ComboBoxItem Content="Gbits/sec" Tag="g" />
                            </ComboBox>

                            <CheckBox x:Name="JsonStreamBox"
                                      Content="Use --json-stream for live chart parsing"
                                      IsChecked="True"
                                      Checked="AnyInputChanged"
                                      Unchecked="AnyInputChanged" />

                            <CheckBox x:Name="VerboseBox"
                                      Content="Verbose output"
                                      Checked="AnyInputChanged"
                                      Unchecked="AnyInputChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Client test"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Streams" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                    <TextBox x:Name="StreamsBox" Text="10" TextChanged="AnyInputChanged" Margin="0,5,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Duration, sec" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                    <TextBox x:Name="DurationBox" Text="10" TextChanged="AnyInputChanged" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Report interval, sec" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                    <TextBox x:Name="IntervalBox" Text="1" TextChanged="AnyInputChanged" Margin="0,5,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="DSCP, optional" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                    <TextBox x:Name="DscpBox" TextChanged="AnyInputChanged" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>

                            <CheckBox x:Name="ReverseBox"
                                      Content="Reverse / download test (-R)"
                                      Checked="AnyInputChanged"
                                      Unchecked="AnyInputChanged" />

                            <CheckBox x:Name="BidirectionalBox"
                                      Content="Bidirectional test (--bidir)"
                                      Checked="AnyInputChanged"
                                      Unchecked="AnyInputChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Transport tuning"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="UDP bandwidth, e.g. 0, 100M, 1G" Foreground="{StaticResource TextMuted}" FontSize="12" />
                            <TextBox x:Name="UdpBandwidthBox" Text="0" TextChanged="AnyInputChanged" Margin="0,5,0,12" />

                            <TextBlock Text="Buffer length, optional, e.g. 128K" Foreground="{StaticResource TextMuted}" FontSize="12" />
                            <TextBox x:Name="BufferLengthBox" TextChanged="AnyInputChanged" Margin="0,5,0,12" />

                            <TextBlock Text="TCP window, optional, e.g. 1M" Foreground="{StaticResource TextMuted}" FontSize="12" />
                            <TextBox x:Name="WindowSizeBox" TextChanged="AnyInputChanged" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Server options"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12" />

                            <CheckBox x:Name="OneOffServerBox"
                                      Content="One-off server, stop after one client (-1)"
                                      Checked="AnyInputChanged"
                                      Unchecked="AnyInputChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource PanelSoft}"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="16"
                Margin="0,18,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Generated command"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBox x:Name="PreviewBox"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             FontFamily="Cascadia Mono, Consolas"
                             MinHeight="54" />
                </StackPanel>

                <DockPanel Grid.Row="1" Margin="0,14,0,0" LastChildFill="False">
                    <TextBlock x:Name="ValidationText"
                               DockPanel.Dock="Left"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" />

                    <Button Content="Cancel"
                            DockPanel.Dock="Right"
                            Style="{StaticResource SecondaryButton}"
                            Width="110"
                            Margin="10,0,0,0"
                            Click="CancelButton_Click" />

                    <Button Content="Use Command"
                            DockPanel.Dock="Right"
                            Style="{StaticResource PrimaryButton}"
                            Width="140"
                            Click="UseButton_Click" />
                </DockPanel>
            </Grid>
        </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
