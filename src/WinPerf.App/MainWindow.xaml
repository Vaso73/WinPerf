<Window x:Class="WinPerf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WinPerf"
        Icon="Assets/WinPerf.ico"
        Width="1220"
        Height="800"
        MinWidth="900"
        MinHeight="620"
        Background="#08111F"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="14" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#08111F" />
        <SolidColorBrush x:Key="Panel" Color="#0F1B2E" />
        <SolidColorBrush x:Key="PanelSoft" Color="#13233A" />
        <SolidColorBrush x:Key="BorderSoft" Color="#203554" />
        <SolidColorBrush x:Key="TextMain" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />
        <SolidColorBrush x:Key="Accent" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentGreen" Color="#22C55E" />
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B" />

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Background" Value="#07101D" />
            <Setter Property="Foreground" Value="#38BDF8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="#07101D">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Background="#203554"
                                           BorderBrush="#38BDF8"
                                           BorderThickness="1" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1628" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0B1628" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#03111F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#172A44" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

            <Border Background="{StaticResource Bg}"
            BorderBrush="#38BDF8"
            BorderThickness="1"
            CornerRadius="14"
            SnapsToDevicePixels="True">
        <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#07101D"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,0,0,1"
                CornerRadius="13,13,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Image Source="Assets/WinPerf.ico"
                           Width="18"
                           Height="18"
                           Margin="0,0,8,0" />
                    <TextBlock Text="WinPerf"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton"
                            Content="—"
                            Width="46"
                            Height="42"
                            Background="Transparent"
                            Foreground="{StaticResource TextMain}"
                            BorderThickness="0"
                            FontSize="14"
                            Click="MinimizeButton_Click" />
                    <Button x:Name="MaximizeRestoreButton"
                            Content="□"
                            Width="46"
                            Height="42"
                            Background="Transparent"
                            Foreground="{StaticResource TextMain}"
                            BorderThickness="0"
                            FontSize="13"
                            Click="MaximizeRestoreButton_Click" />
                    <Button x:Name="CloseButton"
                            Content="×"
                            Width="46"
                            Height="42"
                            Background="Transparent"
                            Foreground="{StaticResource TextMain}"
                            BorderThickness="0"
                            FontSize="18"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
        <Grid MinWidth="1180"
              MinHeight="720">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#07101D"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,0,1,0"
                Padding="22">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="WinPerf"
                               FontSize="30"
                               FontWeight="Bold" />
                    <TextBlock Text="Network Performance Toolkit"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="12"
                               Margin="0,3,0,28" />

                    <Border Background="{StaticResource PanelSoft}" CornerRadius="14" Padding="12" Margin="0,0,0,10">
                        <TextBlock Text="Dashboard" FontWeight="SemiBold" />
                    </Border>
                    <Border CornerRadius="14" Padding="12" Margin="0,0,0,10">
                        <TextBlock Text="Speed Test" Foreground="{StaticResource TextMuted}" />
                    </Border>
                    <Border CornerRadius="14" Padding="12" Margin="0,0,0,10">
                        <TextBlock Text="Server Mode" Foreground="{StaticResource TextMuted}" />
                    </Border>
                    <Border CornerRadius="14" Padding="12" Margin="0,0,0,10">
                        <TextBlock Text="History" Foreground="{StaticResource TextMuted}" />
                    </Border>
                    <Border CornerRadius="14" Padding="12">
                        <TextBlock Text="Settings" Foreground="{StaticResource TextMuted}" />
                    </Border>
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Background="#0B1628"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="Engine" Foreground="{StaticResource TextMuted}" FontSize="12" />
                        <TextBlock x:Name="EngineStatusText"
                                   Text="iperf3.exe not configured"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,22">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Dashboard"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Run iperf3 throughput tests with live visualization and saved results."
                               Foreground="{StaticResource TextMuted}"
                               FontSize="14"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Settings"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0"
                            Click="SettingsButton_Click" />
                    <Button Content="Start Test"
                            Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Test Configuration"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,14" />

                            <TextBlock Text="Server" Foreground="{StaticResource TextMuted}" FontSize="12" />
                            <Grid Margin="0,5,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="82" />
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="ServerBox"
                                          Grid.Column="0"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          Text="10.100.100.1" />

                                <Button x:Name="RemoveServerButton"
                                        Grid.Column="2"
                                        Content="Remove"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="8,0"
                                        Click="RemoveServerButton_Click" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mode" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                    <ComboBox x:Name="ModeBox" SelectedIndex="0" Margin="0,5,0,0">
                                        <ComboBoxItem Content="TCP Upload" />
                                        <ComboBoxItem Content="TCP Download" />
                                        <ComboBoxItem Content="TCP Bidirectional" />
                                        <ComboBoxItem Content="UDP Upload" />
                                        <ComboBoxItem Content="UDP Download" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Port" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                    <TextBox x:Name="PortBox" Text="5201" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Streams" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                    <TextBox x:Name="StreamsBox" Text="10" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Duration" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                    <TextBox x:Name="DurationBox" Text="10" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="StartButton"
                                            Content="Start"
                                            Style="{StaticResource PrimaryButton}"
                                            Width="118"
                                            Margin="0,0,10,0"
                                            Click="StartButton_Click" />
                                    <Button x:Name="StopButton"
                                            Content="Stop"
                                            Style="{StaticResource SecondaryButton}"
                                            Width="96"
                                            IsEnabled="False"
                                            Click="StopButton_Click" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="AdvancedCommandButton"
                                            Content="Advanced"
                                            Style="{StaticResource SecondaryButton}"
                                            Width="118"
                                            Margin="0,0,10,0"
                                            Click="AdvancedCommandButton_Click" />
                                    <Button x:Name="CustomCommandButton"
                                            Content="Custom"
                                            Style="{StaticResource SecondaryButton}"
                                            Width="96"
                                            Click="CustomCommandButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Last Summary"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,14" />
                            <TextBlock Text="No completed test yet."
                                       Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Column="1" Margin="18,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="170" />
                        <RowDefinition Height="*" MinHeight="220" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="150" MinHeight="95" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Throughput" Foreground="{StaticResource TextMuted}" />
                                <TextBlock x:Name="ThroughputValueText" Text="0 Mbps" FontSize="34" FontWeight="Bold" Margin="0,10,0,0" />
                                <TextBlock Text="Live average" Foreground="{StaticResource Accent}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Jitter" Foreground="{StaticResource TextMuted}" />
                                <TextBlock x:Name="JitterValueText" Text="0.00 ms" FontSize="34" FontWeight="Bold" Margin="0,10,0,0" />
                                <TextBlock Text="UDP only" Foreground="{StaticResource AccentAmber}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Loss" Foreground="{StaticResource TextMuted}" />
                                <TextBlock x:Name="LossValueText" Text="0.0 %" FontSize="34" FontWeight="Bold" Margin="0,10,0,0" />
                                <TextBlock Text="UDP only" Foreground="{StaticResource AccentGreen}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="False">
                                <TextBlock Text="Live Throughput"
                                           DockPanel.Dock="Left"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="LiveStatusText"
                                           Text="Waiting for test..."
                                           DockPanel.Dock="Right"
                                           Foreground="{StaticResource TextMuted}" />
                            </DockPanel>

                            <Border Grid.Row="1"
                                    Background="#07101D"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Margin="0,16,0,0">
                                <Grid>
                                    <Canvas x:Name="ThroughputChartCanvas"
                                            ClipToBounds="True"
                                            SizeChanged="ThroughputChartCanvas_SizeChanged">
                                        <Canvas x:Name="ThroughputChartGridCanvas"
                                                ClipToBounds="True" />
                                        <Polyline x:Name="ThroughputChartLine"
                                                  Stroke="{StaticResource Accent}"
                                                  StrokeThickness="2"
                                                  StrokeLineJoin="Round" />
                                        <Canvas x:Name="ThroughputChartMarkerCanvas"
                                                ClipToBounds="True" />
                                    </Canvas>

                                    <TextBlock x:Name="ThroughputChartPlaceholder"
                                               Text="Waiting for throughput samples..."
                                               Foreground="{StaticResource TextMuted}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Row="2"
                                  Height="6"
                                  Margin="0,4"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Background="{StaticResource BorderSoft}"
                                  Cursor="SizeNS"
                                  Opacity="0.75"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"
                                  ShowsPreview="True"
                                  ToolTip="Drag to resize Engine Output" />

                    <Border Grid.Row="3" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Engine Output"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />

                            <TextBox x:Name="EngineOutputText"
                                     Grid.Row="1"
                                     Text="iperf3 JSON stream output will appear here."
                                     Foreground="{StaticResource TextMuted}"
                                     Background="#07101D"
                                     BorderBrush="{StaticResource BorderSoft}"
                                     BorderThickness="1"
                                     Padding="8"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     HorizontalScrollBarVisibility="Disabled"
                                     VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        </Grid>
        </ScrollViewer>
        </Grid>
    </Border>
</Window>
