<Window x:Class="WinPerf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WinPerf"
        Icon="Assets/WinPerf.ico"
        Width="1080"
        Height="720"
        MinWidth="820"
        MinHeight="560"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="12" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>

        <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource CardBase}">
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}" />

        <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxBase}">
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxBase}">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonBase}">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonBase}">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Background" Value="{StaticResource PanelSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              Margin="2,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#172A44" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#172A44" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusPillButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelSoft}" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#18304F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#0EA5E9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="{StaticResource Bg}"
            BorderBrush="{StaticResource Accent}"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True">
        <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PanelDark}"
                    BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0">
                        <Image Source="Assets/WinPerf.ico"
                               Width="16"
                               Height="16"
                               Margin="0,0,6,0" />
                        <TextBlock Text="WinPerf"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton"
                                Content="—"
                                Width="40"
                                Height="38"
                                Background="Transparent"
                                Foreground="{StaticResource TextMain}"
                                BorderThickness="0"
                                FontSize="11"
                                Click="MinimizeButton_Click" />
                        <Button x:Name="MaximizeRestoreButton"
                                Content="□"
                                Width="40"
                                Height="38"
                                Background="Transparent"
                                Foreground="{StaticResource TextMain}"
                                BorderThickness="0"
                                FontSize="11"
                                Click="MaximizeRestoreButton_Click" />
                        <Button x:Name="CloseButton"
                                Content="×"
                                Width="40"
                                Height="38"
                                Background="Transparent"
                                Foreground="{StaticResource TextMain}"
                                BorderThickness="0"
                                FontSize="11"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

        <Grid x:Name="DashboardBodyGrid" Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftRailColumn" Width="410" MinWidth="320" MaxWidth="560" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" MinWidth="520" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource PanelDark}"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,0,1,0"
                Padding="18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="WinPerf"
                               FontSize="30"
                               FontWeight="Bold" />
                    <TextBlock Text="Network Performance Toolkit"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               Margin="0,3,0,28" />

                    <Border Background="{StaticResource PanelSoft}" CornerRadius="12" Padding="10" Margin="0,0,0,8">
                        <TextBlock Text="Dashboard" FontWeight="SemiBold" />
                    </Border>
                    <Border CornerRadius="12" Padding="10" Margin="0,0,0,8">
                        <TextBlock Text="Speed Test" Foreground="{StaticResource TextMuted}" />
                    </Border>
                    <Border CornerRadius="12" Padding="10" Margin="0,0,0,8">
                        <TextBlock Text="Server Mode" Foreground="{StaticResource TextMuted}" />
                    </Border>
                    <Border CornerRadius="12" Padding="10" Margin="0,0,0,8">
                        <TextBlock Text="History" Foreground="{StaticResource TextMuted}" />
                    </Border>
                    <StackPanel x:Name="ConfigColumn" Margin="0,8,0,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Test Configuration"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="Test profile" Foreground="{StaticResource TextMuted}" FontSize="11" />
                            <ComboBox x:Name="DashboardProfileBox"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="DashboardProfileBox_SelectionChanged"
                                      Margin="0,5,0,6" />
                            <TextBlock x:Name="DashboardProfileStatusText"
                                       Text="No saved profile loaded."
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="Server" Foreground="{StaticResource TextMuted}" FontSize="11" />
                            <Grid Margin="0,5,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="76" />
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="ServerBox"
                                          Grid.Column="0"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          Text="10.100.100.1" />

                                <Button x:Name="RemoveServerButton"
                                          Grid.Column="2"
                                          Content="Remove"
                                          Style="{StaticResource SecondaryButton}"
                                          Padding="6,0"
                                          MinHeight="34"
                                          FontSize="11"
                                          Click="RemoveServerButton_Click" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mode" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    <ComboBox x:Name="ModeBox" SelectedIndex="0" Margin="0,3,0,0">
                                        <ComboBoxItem Content="TCP Upload" />
                                        <ComboBoxItem Content="TCP Download" />
                                        <ComboBoxItem Content="TCP Bidirectional" />
                                        <ComboBoxItem Content="UDP Upload" />
                                        <ComboBoxItem Content="UDP Download" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Port" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    <TextBox x:Name="PortBox" Text="5201" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Streams" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    <TextBox x:Name="StreamsBox"
                                               Text="10"
                                               Margin="0,3,0,0"
                                               TextChanged="DashboardInputChanged"
                                               KeyUp="DashboardInputChanged"
                                               LostFocus="DashboardInputChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Duration" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    <TextBox x:Name="DurationBox"
                                               Text="10"
                                               Margin="0,3,0,0"
                                               TextChanged="DashboardInputChanged"
                                               KeyUp="DashboardInputChanged"
                                               LostFocus="DashboardInputChanged" />
                                </StackPanel>
                            </Grid>

                            <StackPanel>
                                <Grid x:Name="RunButtonGrid" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="StartButton"
                                            Grid.Column="0"
                                            Content="Start"
                                            Style="{StaticResource PrimaryButton}"
                                            MinHeight="36"
                                            Click="StartButton_Click" />
                                    <Button x:Name="StopButton"
                                            Grid.Column="2"
                                            Content="Stop"
                                            Style="{StaticResource SecondaryButton}"
                                            MinHeight="36"
                                            IsEnabled="False"
                                            Click="StopButton_Click" />
                                </Grid>

                                <Button x:Name="CommandMenuButton"
                                        Content="Command ▾"
                                        Style="{StaticResource SecondaryButton}"
                                        MinHeight="36"
                                        HorizontalContentAlignment="Center"
                                        Click="CommandMenuButton_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Advanced builder..."
                                                      Click="AdvancedCommandMenuItem_Click" />
                                            <MenuItem Header="Custom command..."
                                                      Click="CustomCommandMenuItem_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>

                                <Border x:Name="CommandOverridePanel"
                                        Visibility="Collapsed"
                                        Margin="0,8,0,0"
                                        Padding="8,6"
                                        CornerRadius="12"
                                        Background="#141B24"
                                        BorderBrush="#2B3544"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="CommandOverrideBadgeText"
                                                       Text="Command override active"
                                                       FontWeight="SemiBold"
                                                       FontSize="11" />
                                            <TextBlock Text="Start uses these arguments instead of dashboard fields."
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <Button x:Name="ClearCommandOverrideButton"
                                                Grid.Column="2"
                                                Content="Clear"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="6,0"
                                                MinWidth="58"
                                                Click="ClearCommandOverrideButton_Click" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Last Summary"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <TextBlock x:Name="LastSummaryText"
                                       Text="No completed test yet."
                                       Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap"
                                       LineHeight="16" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="#10243C"
                      Cursor="SizeWE"
                      Opacity="0.55"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True"
                      ToolTip="Drag to resize left panel" />

        <Grid x:Name="DashboardContentPanel" Grid.Column="2" Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,22">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Dashboard"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Run iperf3 throughput tests with live visualization and saved results."
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               Margin="0,3,0,0" />
                </StackPanel>

            </DockPanel>

            <Grid x:Name="ResultsGrid"
                  Grid.Row="1"
                  Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="MetricsRow" Height="170" />
                        <RowDefinition x:Name="LiveThroughputRow" Height="*" MinHeight="220" />
                        <RowDefinition Height="14" />
                        <RowDefinition x:Name="EngineOutputRow" Height="150" MinHeight="95" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Throughput" Foreground="{StaticResource TextMuted}" />
                                <TextBlock x:Name="ThroughputValueText" Text="0 Mbps" FontSize="34" FontWeight="Bold" Margin="0,8,0,0" />
                                <TextBlock Text="Live average" Foreground="{StaticResource Accent}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Jitter" Foreground="{StaticResource TextMuted}" />
                                <TextBlock x:Name="JitterValueText" Text="0.00 ms" FontSize="34" FontWeight="Bold" Margin="0,8,0,0" />
                                <TextBlock Text="UDP only" Foreground="{StaticResource AccentAmber}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Loss" Foreground="{StaticResource TextMuted}" />
                                <TextBlock x:Name="LossValueText" Text="0.0 %" FontSize="34" FontWeight="Bold" Margin="0,8,0,0" />
                                <TextBlock Text="UDP only" Foreground="{StaticResource AccentGreen}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="False">
                                <TextBlock Text="Live Throughput"
                                           DockPanel.Dock="Left"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="LiveStatusText"
                                           Text="Waiting for test..."
                                           DockPanel.Dock="Right"
                                           Foreground="{StaticResource TextMuted}" />
                            </DockPanel>

                            <Border Grid.Row="1"
                                    Background="{StaticResource PanelDark}"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Margin="0,8,0,0">
                                <Grid>
                                    <Canvas x:Name="ThroughputChartCanvas"
                                            ClipToBounds="True"
                                            SizeChanged="ThroughputChartCanvas_SizeChanged">
                                        <Canvas x:Name="ThroughputChartGridCanvas"
                                                ClipToBounds="True" />
                                        <Canvas x:Name="ThroughputChartStreamCanvas"
                                                ClipToBounds="True" />
                                        <Polyline x:Name="ThroughputChartLine"
                                                  Stroke="{StaticResource Accent}"
                                                  StrokeThickness="2"
                                                  StrokeLineJoin="Round" />
                                        <Canvas x:Name="ThroughputChartMarkerCanvas"
                                                ClipToBounds="True" />
                                    </Canvas>

                                    <TextBlock x:Name="ThroughputChartPlaceholder"
                                               Text="Waiting for throughput samples..."
                                               Foreground="{StaticResource TextMuted}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Row="2"
                                  Height="4"
                                  Margin="0,6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Background="#10243C"
                                  Cursor="SizeNS"
                                  Opacity="0.55"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"
                                  ShowsPreview="True"
                                  ToolTip="Drag to resize Engine Output" />

                    <Border Grid.Row="3" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Engine Output"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />

                            <TextBox x:Name="EngineOutputText"
                                     Grid.Row="1"
                                     Text="iperf3 JSON stream output will appear here."
                                     Foreground="{StaticResource TextMuted}"
                                     Background="{StaticResource PanelDark}"
                                     BorderBrush="{StaticResource BorderSoft}"
                                     BorderThickness="1"
                                     Padding="8"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     HorizontalScrollBarVisibility="Disabled"
                                     VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>
                </Grid>
        </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource PanelDark}"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,1,0,0"
                Padding="18,0">
            <DockPanel LastChildFill="False">
                <Button x:Name="UiDensityButton"
                        DockPanel.Dock="Right"
                        Content="UI: Compact ▾"
                        Style="{StaticResource StatusPillButton}"
                        Margin="12,0,0,0"
                        Click="UiDensityButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="UiDensityContextMenu"
                                     Width="96"
                                     Padding="2"
                                     Background="{StaticResource PanelSoft}"
                                     BorderBrush="{StaticResource BorderSoft}"
                                     BorderThickness="1">
                            <ContextMenu.Resources>
                                <Style TargetType="{x:Type MenuItem}">
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="MinHeight" Value="22" />
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="Foreground" Value="{StaticResource TextMain}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type MenuItem}">
                                                <Border x:Name="ItemBorder"
                                                        Background="Transparent"
                                                        CornerRadius="6"
                                                        MinHeight="{TemplateBinding MinHeight}"
                                                        Padding="{TemplateBinding Padding}"
                                                        SnapsToDevicePixels="True">
                                                    <TextBlock Text="{TemplateBinding Header}"
                                                               Foreground="{TemplateBinding Foreground}"
                                                               FontSize="{TemplateBinding FontSize}"
                                                               FontWeight="{TemplateBinding FontWeight}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="None" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsHighlighted" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#1A2B45" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ContextMenu.Resources>
                            <MenuItem x:Name="CompactUiDensityMenuItem"
                                      Header="Compact"
                                      Click="CompactUiDensityMenuItem_Click" />
                            <MenuItem x:Name="ComfortableUiDensityMenuItem"
                                      Header="Comfortable"
                                      Click="ComfortableUiDensityMenuItem_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Button x:Name="SettingsButton"
                        DockPanel.Dock="Right"
                        Content="Settings"
                        Style="{StaticResource StatusPillButton}"
                        MinWidth="86"
                        Margin="12,0,0,0"
                        ToolTip="Open Settings"
                        Click="SettingsButton_Click" />

                <TextBlock x:Name="EngineStatusText"
                           DockPanel.Dock="Left"
                           Text="Engine  ●  Not configured"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Cursor="Hand"
                           ToolTip="Click to configure iperf3 engine"
                           MouseLeftButtonUp="EngineStatusText_MouseLeftButtonUp" />
            </DockPanel>
        </Border>
        </Grid>
    </Border>
</Window>
