<Window x:Class="WinPerf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:WinPerf.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WinPerf"
        Icon="Assets/WinPerf.ico"
        Width="1080"
        Height="720"
        MinWidth="760"
        MinHeight="520"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <app:AppWindowChrome />
    </shell:WindowChrome.WindowChrome>
    <Border Style="{StaticResource ShellWindowBorder}">
        <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ShellTitleBar}">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0">
                        <Image Source="Assets/WinPerf.ico"
                               Width="16"
                               Height="16"
                               Margin="0,0,6,0" />
                        <TextBlock Text="WinPerf"
                                   Style="{StaticResource ShellTitleText}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="AppMenuButton"
                                Content="⋯"
                                AutomationProperties.AutomationId="AppMenuButton"
                                Style="{StaticResource ShellMenuButton}"
                                ToolTip="Open app settings, updates and information"
                                Click="AppMenuButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="AppContextMenu"
                                             Width="210"
                                             Padding="4">
                                    <MenuItem x:Name="SettingsMenuItem"
                                              Header="Settings"
                                              AutomationProperties.AutomationId="SettingsMenuItem"
                                              Click="SettingsMenuItem_Click" />
                                    <MenuItem x:Name="UpdatesMenuItem"
                                              Header="Sponsor Pro / Updates"
                                              AutomationProperties.AutomationId="UpdatesMenuItem"
                                              Click="UpdatesMenuItem_Click" />
                                    <MenuItem x:Name="AboutMenuItem"
                                              Header="About WinPerf"
                                              AutomationProperties.AutomationId="AboutMenuItem"
                                              Click="AboutMenuItem_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="MinimizeButton"
                                Content="—"
                                Style="{StaticResource ShellTitleButton}"
                                Click="MinimizeButton_Click" />
                        <Button x:Name="MaximizeRestoreButton"
                                Content="□"
                                Style="{StaticResource ShellTitleButton}"
                                Click="MaximizeRestoreButton_Click" />
                        <Button x:Name="CloseButton"
                                Content="×"
                                Style="{StaticResource ShellCloseTitleButton}"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

        <Grid x:Name="DashboardBodyGrid" Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftRailColumn" Width="360" MinWidth="280" MaxWidth="500" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" MinWidth="520" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource PanelDark}"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,0,1,0"
                Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="WinPerf"
                               FontSize="30"
                               FontWeight="Bold" />
                    <TextBlock Text="Network Performance Toolkit"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               Margin="0,3,0,28" />

                    <Button x:Name="DashboardNavButton"
                            Content="Dashboard"
                            AutomationProperties.AutomationId="DashboardNavButton"
                            Style="{StaticResource SidebarNavSelectedButton}"
                            Click="DashboardNavButton_Click" />
                    <Button x:Name="SpeedTestNavButton"
                            Content="Speed Test"
                            AutomationProperties.AutomationId="SpeedTestNavButton"
                            Style="{StaticResource SidebarNavButton}"
                            IsEnabled="False"
                            ToolTip="Speed Test page will be added later." />
                    <Button x:Name="ServerModeNavButton"
                            Content="Server Mode"
                            AutomationProperties.AutomationId="ServerModeNavButton"
                            Style="{StaticResource SidebarNavButton}"
                            Click="ServerModeNavButton_Click" />
                    <Button x:Name="HistoryNavButton"
                            Content="History"
                            AutomationProperties.AutomationId="HistoryNavButton"
                            Style="{StaticResource SidebarNavButton}"
                            IsEnabled="False"
                            ToolTip="History page will be added later." />

                    <Border x:Name="CompactIntegrationsCard"
                            Style="{StaticResource Card}"
                            Margin="0,10,0,8"
                            Padding="12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Integrations"
                                           DockPanel.Dock="Left"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Loaded"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="11" />
                            </DockPanel>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="7" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="iperf3" FontWeight="SemiBold" />
                                    <TextBlock x:Name="Iperf3IntegrationDetailText"
                                               Text="Checking..."
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="Iperf3IntegrationPathText"
                                               Visibility="Collapsed" />
                                </StackPanel>
                                <Border x:Name="Iperf3IntegrationStatusChip"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource CompactStatusChip}">
                                    <TextBlock x:Name="Iperf3IntegrationStatusText"
                                               Text="Checking"
                                               Foreground="{StaticResource AccentGreen}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="iperf2" FontWeight="SemiBold" />
                                    <TextBlock x:Name="Iperf2IntegrationDetailText"
                                               Text="Checking..."
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="Iperf2IntegrationPathText"
                                               Visibility="Collapsed" />
                                </StackPanel>
                                <Border x:Name="Iperf2IntegrationStatusChip"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource CompactStatusChip}">
                                    <TextBlock x:Name="Iperf2IntegrationStatusText"
                                               Text="Checking"
                                               Foreground="{StaticResource AccentGreen}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="ConfigColumn" Margin="0,8,0,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Test Configuration"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="Test profile" Foreground="{StaticResource TextMuted}" FontSize="11" />
                            <ComboBox x:Name="DashboardProfileBox"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="DashboardProfileBox_SelectionChanged"
                                      Margin="0,5,0,6" />
                            <TextBlock x:Name="DashboardProfileStatusText"
                                       Text="No saved profile loaded."
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="Server" Foreground="{StaticResource TextMuted}" FontSize="11" />
                            <Grid Margin="0,5,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="76" />
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="ServerBox"
                                          Grid.Column="0"
                                          AutomationProperties.AutomationId="DashboardServerBox"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          ToolTip="Enter server address or select one from recent servers."
                                          TextBoxBase.TextChanged="DashboardInputChanged"
                                          SelectionChanged="DashboardInputChanged"
                                          KeyUp="DashboardInputChanged"
                                          LostFocus="DashboardInputChanged" />

                                <Button x:Name="RemoveServerButton"
                                          Grid.Column="2"
                                          Content="Remove"
                                          AutomationProperties.AutomationId="DashboardRemoveServerButton"
                                          Style="{StaticResource CompactSecondaryButton}"
                                          Padding="6,0"
                                          MinHeight="30"
                                          FontSize="11"
                                          Click="RemoveServerButton_Click" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Engine" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    <ComboBox x:Name="EngineBox"
                                              AutomationProperties.AutomationId="DashboardEngineBox"
                                              SelectedIndex="0"
                                              Margin="0,3,0,0"
                                              SelectionChanged="EngineSelectionChanged">
                                        <ComboBoxItem Content="iperf3" />
                                        <ComboBoxItem Content="iperf2" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Mode" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    <ComboBox x:Name="ModeBox"
                                              AutomationProperties.AutomationId="DashboardModeBox"
                                              SelectedIndex="0"
                                              Margin="0,3,0,0"
                                              SelectionChanged="DashboardInputChanged">
                                        <ComboBoxItem Content="TCP Upload" />
                                        <ComboBoxItem Content="TCP Download" />
                                        <ComboBoxItem Content="TCP Bidirectional" />
                                        <ComboBoxItem Content="UDP Upload" />
                                        <ComboBoxItem Content="UDP Download" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Port" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    <TextBox x:Name="PortBox"
                                             AutomationProperties.AutomationId="DashboardPortBox"
                                             Text="5201"
                                             Margin="0,3,0,0"
                                             TextChanged="DashboardInputChanged"
                                             KeyUp="DashboardInputChanged"
                                             LostFocus="DashboardInputChanged" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Streams" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    <TextBox x:Name="StreamsBox"
                                               AutomationProperties.AutomationId="DashboardStreamsBox"
                                               Text="10"
                                               Margin="0,3,0,0"
                                               TextChanged="DashboardInputChanged"
                                               KeyUp="DashboardInputChanged"
                                               LostFocus="DashboardInputChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Duration" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    <TextBox x:Name="DurationBox"
                                               AutomationProperties.AutomationId="DashboardDurationBox"
                                               Text="10"
                                               Margin="0,3,0,0"
                                               TextChanged="DashboardInputChanged"
                                               KeyUp="DashboardInputChanged"
                                               LostFocus="DashboardInputChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Omit" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    <TextBox x:Name="OmitSecondsBox"
                                               AutomationProperties.AutomationId="DashboardOmitSecondsBox"
                                               Text="0"
                                               Margin="0,3,0,0"
                                               ToolTip="Warm-up seconds to ignore. Use 10–15 for routed, VLAN, VPN, or public server download tests."
                                               TextChanged="DashboardInputChanged"
                                               KeyUp="DashboardInputChanged"
                                               LostFocus="DashboardInputChanged" />
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="UdpBandwidthPanel"
                                        Margin="0,0,0,8"
                                        Visibility="Collapsed">
                                <TextBlock Text="Bandwidth / stream"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="11" />
                                <TextBox x:Name="UdpBandwidthBox"
                                         AutomationProperties.AutomationId="DashboardUdpBandwidthBox"
                                         Text="10M"
                                         Margin="0,3,0,0"
                                         ToolTip="Target UDP bandwidth per stream. With 10 streams, 10M is about 100M total."
                                         TextChanged="DashboardInputChanged"
                                         KeyUp="DashboardInputChanged"
                                         LostFocus="DashboardInputChanged" />
                            </StackPanel>

                            <StackPanel>
                                <Grid x:Name="RunButtonGrid" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="StartButton"
                                            Grid.Column="0"
                                            Content="Start"
                                            AutomationProperties.AutomationId="DashboardStartButton"
                                            Style="{StaticResource PrimaryButton}"
                                            MinHeight="36"
                                            Click="StartButton_Click" />
                                    <Button x:Name="StopButton"
                                            Grid.Column="2"
                                            Content="Stop"
                                            AutomationProperties.AutomationId="DashboardStopButton"
                                            Style="{StaticResource SecondaryButton}"
                                            MinHeight="36"
                                            IsEnabled="False"
                                            Click="StopButton_Click" />
                                </Grid>

                                <Button x:Name="CommandMenuButton"
                                        Content="Command ▾"
                                        AutomationProperties.AutomationId="DashboardCommandMenuButton"
                                        Style="{StaticResource SecondaryButton}"
                                        MinHeight="36"
                                        HorizontalContentAlignment="Center"
                                        Click="CommandMenuButton_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Advanced builder..."
                                                      Click="AdvancedCommandMenuItem_Click" />
                                            <MenuItem Header="Custom command..."
                                                      Click="CustomCommandMenuItem_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>

                                <Border x:Name="CommandOverridePanel"
                                        Visibility="Collapsed"
                                        Margin="0,8,0,0"
                                        Padding="8,6"
                                        CornerRadius="12"
                                        Background="{StaticResource CommandPanelBackground}"
                                        BorderBrush="{StaticResource CommandPanelBorder}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="CommandOverrideBadgeText"
                                                       Text="Command override active"
                                                       FontWeight="SemiBold"
                                                       FontSize="11" />
                                            <TextBlock Text="Start uses these arguments instead of dashboard fields."
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <Button x:Name="ClearCommandOverrideButton"
                                                Grid.Column="2"
                                                Content="Clear"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="6,0"
                                                MinWidth="58"
                                                Click="ClearCommandOverrideButton_Click" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Last Summary"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <TextBlock x:Name="LastSummaryText"
                                       Text="No completed test yet."
                                       Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap"
                                       LineHeight="16" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="{StaticResource SplitterBackground}"
                      Cursor="SizeWE"
                      Opacity="0.55"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True"
                      ToolTip="Drag to resize left panel" />

        <Grid x:Name="DashboardContentPanel" Grid.Column="2" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,22">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Dashboard"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Run iperf3 and iperf2 throughput tests with live visualization and saved results."
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               Margin="0,3,0,0" />
                </StackPanel>

            </DockPanel>

            <Grid x:Name="ResultsGrid"
                  Grid.Row="1"
                  Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="MetricsRow" Height="150" />
                        <RowDefinition x:Name="LiveThroughputRow" Height="*" MinHeight="260" />
                        <RowDefinition Height="14" />
                        <RowDefinition x:Name="EngineOutputRow" Height="180" MinHeight="110" MaxHeight="260" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Total bandwidth" Foreground="{StaticResource TextMuted}" />
                                <TextBlock x:Name="ThroughputValueText" Text="0 Mbps" FontSize="34" FontWeight="Bold" Margin="0,8,0,0" />
                                <TextBlock x:Name="ThroughputCaptionText"
                                           Text="Live total average"
                                           Foreground="{StaticResource Accent}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Jitter" Foreground="{StaticResource TextMuted}" />
                                <TextBlock x:Name="JitterValueText" Text="0.00 ms" FontSize="34" FontWeight="Bold" Margin="0,8,0,0" />
                                <TextBlock Text="UDP only" Foreground="{StaticResource AccentAmber}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Loss" Foreground="{StaticResource TextMuted}" />
                                <TextBlock x:Name="LossValueText" Text="0.0 %" FontSize="34" FontWeight="Bold" Margin="0,8,0,0" />
                                <TextBlock Text="UDP only" Foreground="{StaticResource AccentGreen}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="False">
                                <TextBlock Text="Live Total Throughput"
                                           DockPanel.Dock="Left"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="LiveStatusText"
                                           Text="Waiting for test..."
                                           DockPanel.Dock="Right"
                                           Foreground="{StaticResource TextMuted}" />
                            </DockPanel>

                            <Border Grid.Row="1"
                                    Background="{StaticResource PanelDark}"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Margin="0,8,0,0">
                                <Grid>
                                    <Canvas x:Name="ThroughputChartCanvas"
                                            ClipToBounds="True"
                                            SizeChanged="ThroughputChartCanvas_SizeChanged">
                                        <Canvas x:Name="ThroughputChartGridCanvas"
                                                ClipToBounds="True" />
                                        <Canvas x:Name="ThroughputChartStreamCanvas"
                                                ClipToBounds="True" />
                                        <Polyline x:Name="ThroughputChartLine"
                                                  Stroke="{StaticResource Accent}"
                                                  StrokeThickness="2"
                                                  StrokeLineJoin="Round" />
                                        <Canvas x:Name="ThroughputChartMarkerCanvas"
                                                ClipToBounds="True" />
                                    </Canvas>

                                    <TextBlock x:Name="ThroughputChartPlaceholder"
                                               Text="Waiting for throughput samples..."
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               LineHeight="18"
                                               Foreground="{StaticResource TextMuted}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Row="2"
                                  Height="4"
                                  Margin="0,6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Background="{StaticResource SplitterBackground}"
                                  Cursor="SizeNS"
                                  Opacity="0.55"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"
                                  ShowsPreview="True"
                                  ToolTip="Drag to resize Engine Output" />

                    <Border Grid.Row="3" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Engine Output"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />

                            <TextBox x:Name="EngineOutputText"
                                     Grid.Row="1"
                                     AutomationProperties.AutomationId="DashboardEngineOutputText"
                                     Text="iperf output will appear here."
                                     Foreground="{StaticResource TextMuted}"
                                     Background="{StaticResource PanelDark}"
                                     BorderBrush="{StaticResource BorderSoft}"
                                     BorderThickness="1"
                                     Padding="8"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     TextWrapping="Wrap"
                                     HorizontalScrollBarVisibility="Disabled"
                                     VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>
                </Grid>
        </Grid>

        <Grid x:Name="ServerModeContentPanel"
              Grid.Column="2"
              Margin="18"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,22">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Server Mode"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Run a local iperf server for LAN, routed, VPN or public-client testing."
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Local server"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="ServerModeStatusText"
                                           Text="Stopped"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Border x:Name="ServerModeStatusChip"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource CompactStatusChip}">
                                <TextBlock x:Name="ServerModeStatusChipText"
                                           Text="Stopped"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </DockPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Engine" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                <ComboBox x:Name="ServerEngineBox"
                                          AutomationProperties.AutomationId="ServerModeEngineBox"
                                          SelectedIndex="0"
                                          Margin="0,3,0,0"
                                          SelectionChanged="ServerModeInputChanged">
                                    <ComboBoxItem Content="iperf3" />
                                    <ComboBoxItem Content="iperf2" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Protocol" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                <ComboBox x:Name="ServerProtocolBox"
                                          AutomationProperties.AutomationId="ServerModeProtocolBox"
                                          SelectedIndex="0"
                                          Margin="0,3,0,0"
                                          SelectionChanged="ServerModeInputChanged">
                                    <ComboBoxItem Content="TCP" />
                                    <ComboBoxItem Content="UDP" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Port" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                <TextBox x:Name="ServerPortBox"
                                         AutomationProperties.AutomationId="ServerModePortBox"
                                         Text="5201"
                                         Margin="0,3,0,0"
                                         TextChanged="ServerModeInputChanged"
                                         KeyUp="ServerModeInputChanged"
                                         LostFocus="ServerModeInputChanged" />
                            </StackPanel>

                            <Grid Grid.Column="6"
                                  VerticalAlignment="Bottom">
                                <CheckBox x:Name="ServerOneOffBox"
                                          Content="Stop after one client (--one-off)"
                                          AutomationProperties.AutomationId="ServerModeOneOffBox"
                                          VerticalAlignment="Center"
                                          Checked="ServerModeInputChanged"
                                          Unchecked="ServerModeInputChanged" />
                                <TextBlock x:Name="ServerOneOffUnavailableText"
                                           Text="One-off is iperf3 only. iperf2 runs until stopped."
                                           AutomationProperties.AutomationId="ServerModeOneOffUnavailableText"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="StartServerButton"
                                    Grid.Column="0"
                                    Content="Start server"
                                    AutomationProperties.AutomationId="ServerModeStartServerButton"
                                    Style="{StaticResource PrimaryButton}"
                                    MinHeight="36"
                                    Click="StartServerButton_Click" />
                            <Button x:Name="StopServerButton"
                                    Grid.Column="2"
                                    Content="Stop server"
                                    AutomationProperties.AutomationId="ServerModeStopServerButton"
                                    Style="{StaticResource SecondaryButton}"
                                    MinHeight="36"
                                    IsEnabled="False"
                                    Click="StopServerButton_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Server Output"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <TextBox x:Name="ServerOutputText"
                                 Grid.Row="1"
                                 AutomationProperties.AutomationId="ServerModeOutputText"
                                 Text="Server command preview will appear here."
                                 Foreground="{StaticResource TextMuted}"
                                 Background="{StaticResource PanelDark}"
                                 BorderBrush="{StaticResource BorderSoft}"
                                 BorderThickness="1"
                                 Padding="8"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 TextWrapping="Wrap"
                                 HorizontalScrollBarVisibility="Disabled"
                                 VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource PanelDark}"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,1,0,0"
                Padding="18,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="AppVersionText"
                               Text="WinPerf"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               ToolTip="Application version from the running executable." />
                    <TextBlock x:Name="EngineStatusText"
                               Text="Engine  ●  Not configured"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               ToolTip="Selected engine integration status" />
                </StackPanel>
            </DockPanel>
        </Border>
        </Grid>
    </Border>
</Window>
