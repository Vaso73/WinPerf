<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg" Color="#08111F" />
    <SolidColorBrush x:Key="Panel" Color="#0F1B2E" />
    <SolidColorBrush x:Key="PanelSoft" Color="#13233A" />
    <SolidColorBrush x:Key="BorderSoft" Color="#203554" />
    <SolidColorBrush x:Key="TextMain" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />
    <SolidColorBrush x:Key="Accent" Color="#38BDF8" />
    <SolidColorBrush x:Key="AccentGreen" Color="#22C55E" />
    <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B" />

    <Style x:Key="CardBase" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>

    <Style x:Key="PrimaryButtonBase" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="#03111F" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="SecondaryButtonBase" TargetType="Button" BasedOn="{StaticResource PrimaryButtonBase}">
        <Setter Property="Background" Value="#172A44" />
        <Setter Property="Foreground" Value="{StaticResource TextMain}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Background" Value="#07101D" />
        <Setter Property="Foreground" Value="#38BDF8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="#07101D">
                        <Track x:Name="PART_Track"
                               IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Background="#203554"
                                       BorderBrush="#38BDF8"
                                       BorderThickness="1" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
