<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg" Color="#08111F" />
    <SolidColorBrush x:Key="PanelDark" Color="#07101D" />
    <SolidColorBrush x:Key="Panel" Color="#0F1B2E" />
    <SolidColorBrush x:Key="PanelSoft" Color="#13233A" />
    <SolidColorBrush x:Key="BorderSoft" Color="#203554" />
    <SolidColorBrush x:Key="TextMain" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />
    <SolidColorBrush x:Key="Accent" Color="#38BDF8" />
    <SolidColorBrush x:Key="AccentGreen" Color="#22C55E" />
    <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B" />

    <Style x:Key="TextBlockBase" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMain}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <Style x:Key="TextBoxBase" TargetType="TextBox">
        <Setter Property="Background" Value="#0B1628" />
        <Setter Property="Foreground" Value="{StaticResource TextMain}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="ComboBoxBase" TargetType="ComboBox">
        <Setter Property="Background" Value="#0B1628" />
        <Setter Property="Foreground" Value="#0F172A" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="CardBase" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>

    <Style x:Key="PrimaryButtonBase" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="#03111F" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonChrome" Property="Background" Value="#7DD3FC" />
                            <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#7DD3FC" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonChrome" Property="Background" Value="#0284C7" />
                            <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#0284C7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonChrome" Property="Background" Value="#13233A" />
                            <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource BorderSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                            <Setter Property="Opacity" Value="0.55" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonBase" TargetType="Button" BasedOn="{StaticResource PrimaryButtonBase}">
        <Setter Property="Background" Value="#172A44" />
        <Setter Property="Foreground" Value="{StaticResource TextMain}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonChrome" Property="Background" Value="#1B2A44" />
                            <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonChrome" Property="Background" Value="#243653" />
                            <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonChrome" Property="Background" Value="#13233A" />
                            <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource BorderSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                            <Setter Property="Opacity" Value="0.55" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Background" Value="{StaticResource PanelDark}" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="{StaticResource PanelDark}">
                        <Track x:Name="PART_Track"
                               IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Background="{StaticResource BorderSoft}"
                                       BorderBrush="{StaticResource Accent}"
                                       BorderThickness="1" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
