<Window x:Class="WinPerf.App.HistoryDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:WinPerf.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="History detail"
        Icon="Assets/WinPerf.ico"
        Width="720"
        Height="520"
        MinWidth="660"
        MinHeight="440"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <app:AppWindowChrome />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource ShellWindowBorder}">
        <DockPanel Background="{StaticResource Bg}">
            <Border DockPanel.Dock="Top"
                    Style="{StaticResource ShellTitleBar}">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0">
                        <Image Source="Assets/WinPerf.ico"
                               Width="16"
                               Height="16"
                               Margin="0,0,6,0" />
                        <TextBlock Text="History detail"
                                   Style="{StaticResource ShellTitleText}" />
                    </StackPanel>

                    <Button Content="×"
                            HorizontalAlignment="Right"
                            Style="{StaticResource ShellCloseTitleButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource PanelDark}"
                    BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="0,1,0,0"
                    Padding="18">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CopyCommandButton"
                            Content="Copy command"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"
                            Click="CopyCommandButton_Click" />
                    <Button Content="Close"
                            Style="{StaticResource PrimaryButton}"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Border>

            <Grid Margin="22,18,22,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="TitleText"
                               Text="iperf result"
                               FontSize="21"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="MetaText"
                               Text="Finished"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Row="2"
                        Style="{StaticResource CompactSectionCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Result details"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="DetailsText"
                                   Grid.Row="2"
                                   Foreground="{StaticResource TextMain}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   LineHeight="18" />
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CompactSectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Summary"
                                       FontWeight="SemiBold" />
                            <TextBox x:Name="SummaryBox"
                                     Grid.Row="2"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     MinHeight="78"
                                     VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CompactSectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Command"
                                       FontWeight="SemiBold" />
                            <TextBox x:Name="CommandBox"
                                     Grid.Row="2"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
