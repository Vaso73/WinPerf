<Window x:Class="WinPerf.App.SponsorProUpdatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:WinPerf.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Sponsor Pro / Updates"
        Icon="Assets/WinPerf.ico"
        Width="760"
        Height="560"
        MinWidth="680"
        MinHeight="500"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <app:AppWindowChrome />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource ShellWindowBorder}">
        <Grid Background="{StaticResource Bg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ShellTitleBar}">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0">
                        <Image Source="Assets/WinPerf.ico"
                               Width="16"
                               Height="16"
                               Margin="0,0,6,0" />
                        <TextBlock Text="Sponsor Pro / Updates"
                                   Style="{StaticResource ShellTitleText}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton"
                                Content="—"
                                Style="{StaticResource ShellTitleButton}"
                                Click="MinimizeButton_Click" />
                        <Button x:Name="MaximizeRestoreButton"
                                Content="□"
                                Style="{StaticResource ShellTitleButton}"
                                Click="MaximizeRestoreButton_Click" />
                        <Button x:Name="CloseButton"
                                Content="×"
                                Style="{StaticResource ShellCloseTitleButton}"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Sponsor Pro / Updates"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="GitHub Sponsor Pro account, private update channel and WinPerf update package status."
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border x:Name="SponsorAccountCard" Style="{StaticResource SectionCardSpaced}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="21"
                                        Background="{StaticResource Accent}"
                                        Margin="0,0,12,0">
                                    <TextBlock x:Name="AccountBadgeText"
                                               Text="GH"
                                               Foreground="{StaticResource Bg}"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock x:Name="AccountTitleText"
                                                   Text="Not signed in"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <Border x:Name="AccountStatusChip"
                                                Style="{StaticResource StatusChip}"
                                                MinWidth="96"
                                                Margin="10,0,0,0">
                                            <TextBlock x:Name="AccountStatusChipText"
                                                       Text="Missing"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="AccountStatusText"
                                               Text="Sign in with GitHub to use Sponsor Pro updates."
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Button x:Name="SponsorProAccountButton"
                                        Grid.Column="2"
                                        Content="Sign in with GitHub"
                                        Style="{StaticResource SecondaryButton}"
                                        Width="180"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center"
                                        Click="SponsorProAccountButton_Click" />
                            </Grid>
                        </Border>

                        <ProgressBar x:Name="BusyProgress"
                                     Height="4"
                                     Margin="12,0,12,12"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed" />

                        <Border x:Name="UpdateChannelCard" Style="{StaticResource SectionCardSpaced}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Update channel"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Text="Private Sponsor Pro updater"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="11" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Core" Margin="0,0,12,8" />
                                <Border x:Name="UpdateCoreStatusChip"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource StatusChip}"
                                        Margin="0,0,12,8">
                                    <TextBlock x:Name="UpdateCoreStatusText"
                                               Text="Ready"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="2"
                                           Grid.Column="2"
                                           Text="Client, manifest validation and installer contracts loaded"
                                           Foreground="{StaticResource TextMuted}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,8" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Product" Margin="0,0,12,8" />
                                <TextBlock x:Name="ProductText"
                                           Grid.Row="3"
                                           Grid.Column="1"
                                           Text="winperf"
                                           FontWeight="SemiBold"
                                           Margin="0,0,12,8" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="2"
                                           Text="sponsor-pro / WinPerf.zip"
                                           Foreground="{StaticResource TextMuted}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,8" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Installed" Margin="0,0,12,8" />
                                <TextBlock x:Name="InstalledVersionText"
                                           Grid.Row="4"
                                           Grid.Column="1"
                                           Text="WinPerf"
                                           FontWeight="SemiBold"
                                           Margin="0,0,12,8" />
                                <TextBlock Grid.Row="4"
                                           Grid.Column="2"
                                           Text="Portable single-EXE runtime"
                                           Foreground="{StaticResource TextMuted}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,8" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Latest" Margin="0,0,12,8" />
                                <Border x:Name="UpdateStateChip"
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        Style="{StaticResource StatusChip}"
                                        Margin="0,0,12,8">
                                    <TextBlock x:Name="UpdateStateText"
                                               Text="Idle"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="LatestVersionText"
                                           Grid.Row="5"
                                           Grid.Column="2"
                                           Text="Not checked yet"
                                           Foreground="{StaticResource TextMuted}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,8" />

                                <StackPanel Grid.Row="6"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="3"
                                            Orientation="Horizontal"
                                            Margin="0,8,0,0">
                                    <Button x:Name="CheckUpdatesButton"
                                            Content="Check for updates"
                                            Style="{StaticResource SecondaryButton}"
                                            Width="170"
                                            Click="CheckUpdatesButton_Click" />
                                    <Button x:Name="InstallUpdateButton"
                                            Content="Install update"
                                            Style="{StaticResource SecondaryButton}"
                                            Width="150"
                                            Margin="8,0,0,0"
                                            IsEnabled="False"
                                            ToolTip="Installer launcher/startup wiring is the next updater slice." />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource PanelSoft}"
                                BorderBrush="{StaticResource BorderSoft}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14">
                            <TextBlock x:Name="StatusText"
                                       Text="Ready. Sign in to enable Sponsor Pro update checks."
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="2"
                        Content="Close"
                        Style="{StaticResource PrimaryButton}"
                        Width="110"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0"
                        Click="CloseButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
